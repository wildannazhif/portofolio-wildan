---
import { education, organisations } from "../data/portfolio.ts";
---

<div class="cv-lazy mx-auto grid max-w-6xl gap-14 px-4 pb-14 sm:px-6 lg:grid-cols-2 lg:gap-12">
  <section id="education" aria-labelledby="education-heading" class="scroll-mt-8">
    <div class="border-t-2 border-black pt-4">
      <h2 id="education-heading" class="text-3xl font-bold tracking-tight text-black sm:text-4xl">Education</h2>
    </div>
    <ol class="mt-2">
      {
        education.map((edu) => (
          <li class="border-t border-neutral-300 py-6 first:border-t-0">
            <p class="tnum text-sm font-bold text-black">
              {edu.period} <span class="font-medium text-neutral-600">· {edu.location}</span>
            </p>
            <h3 class="mt-2 text-xl font-bold text-black">{edu.institution}</h3>
            <p class="mt-0.5 text-base font-bold text-black">
              {edu.degree}
              {edu.gpa && <span class="tnum font-medium text-neutral-700"> — GPA {edu.gpa}</span>}
            </p>
            <ul class="mt-4 space-y-2">
              {edu.highlights.map((h) => (
                <li class="flex gap-2.5 text-base leading-relaxed text-neutral-800">
                  <span aria-hidden="true" class="shrink-0 text-black">—</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="leadership" aria-labelledby="leadership-heading" class="scroll-mt-8">
    <div class="border-t-2 border-black pt-4">
      <h2 id="leadership-heading" class="text-3xl font-bold tracking-tight text-black sm:text-4xl">Leadership</h2>
    </div>
    <ol class="mt-2">
      {
        organisations.map((org) => (
          <li class="border-t border-neutral-300 py-6 first:border-t-0">
            <p class="tnum text-sm font-bold text-black">
              {org.period} <span class="font-medium text-neutral-600">· {org.role}</span>
            </p>
            <h3 class="mt-2 text-xl font-bold text-black">{org.name}</h3>
            <p class="mt-3 max-w-[62ch] text-base leading-relaxed text-neutral-800">{org.description}</p>
            <ul class="mt-4 space-y-2">
              {org.achievements.map((ach) => (
                <li class="flex gap-2.5 text-base leading-relaxed text-neutral-800">
                  <span aria-hidden="true" class="shrink-0 text-black">—</span>
                  <span>{ach}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>
</div>
