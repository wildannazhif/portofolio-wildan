---
import { profile, stats } from "../data/portfolio.ts";
---

<section aria-labelledby="about-heading" class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
  <div class="rounded-3xl bg-indigo-600 px-6 py-8 text-white sm:px-10 sm:py-10">
    <h2 id="about-heading" class="text-xs font-bold uppercase tracking-[0.2em] text-indigo-200">
      Professional Summary
    </h2>
    <p class="mt-4 text-lg font-medium leading-relaxed sm:text-xl">{profile.summary}</p>
  </div>

  <dl class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {
      stats.map((s) => (
        <div class="flex flex-col rounded-2xl border border-neutral-200 bg-white p-4">
          <dt class="order-2 mt-1 block text-xs font-medium leading-snug text-neutral-700">{s.label}</dt>
          <dd class="order-1 text-2xl font-bold tracking-tight text-black sm:text-3xl">{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
