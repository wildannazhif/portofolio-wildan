---
import { nav, profile } from "../data/portfolio.ts";
---

<!--
  Masthead, not an app bar: static (document-like, no sticky), double rule,
  index as plain text links separated by slashes. No pills, no buttons,
  no badge. This is a table of contents, not a nav bar.
-->
<header class="mx-auto max-w-6xl px-4 pt-6 sm:px-6">
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <p class="text-sm font-bold tracking-[0.14em] text-black">
      {profile.name.toUpperCase()}
    </p>
    <p class="tnum text-xs font-bold tracking-[0.14em] text-neutral-600">
      CURRICULUM VITAE — 2026
    </p>
  </div>
  <!-- Double rule: the masthead divider. -->
  <div class="mt-3 border-t-[3px] border-black">
    <div class="mt-[2px] border-t border-black"></div>
  </div>
  <nav aria-label="Contents" class="py-3">
    <p class="text-sm leading-relaxed text-black">
      <span class="font-bold">Index&nbsp;&nbsp;</span>
      {
        nav.map((item, i) => (
          <span>
            {i > 0 && <span aria-hidden="true" class="px-1 text-neutral-400">/</span>}
            <a href={item.href} class="font-medium underline decoration-neutral-300 underline-offset-4 hover:decoration-black">
              {item.label}
            </a>
          </span>
        ))
      }
      <span aria-hidden="true" class="px-1 text-neutral-400">/</span>
      <a
        href={profile.resume}
        target="_blank"
        rel="noreferrer"
        class="font-medium underline decoration-neutral-300 underline-offset-4 hover:decoration-black"
      >
        Résumé&nbsp;↗
      </a>
    </p>
  </nav>
  <div class="border-t border-black"></div>
</header>
