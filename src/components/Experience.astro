---
import { experiences } from "../data/portfolio.ts";
---

<!--
  Ledger, not cards: date column + content column, hairline rules between
  entries. No side stripes, no shadows, no rounded corners, no pills.
-->
<section id="experience" class="cv-lazy mx-auto max-w-6xl scroll-mt-8 px-4 pb-14 sm:px-6">
  <div class="border-t-2 border-black pt-4">
    <h2 class="text-3xl font-bold tracking-tight text-black sm:text-4xl">Experience</h2>
  </div>

  <ol class="mt-2">
    {
      experiences.map((exp) => (
        <li class="grid gap-1 border-t border-neutral-300 py-6 first:border-t-0 sm:grid-cols-[170px_1fr] sm:gap-10">
          <div>
            <p class="tnum text-sm font-bold text-black">{exp.period}</p>
            <p class="mt-1 text-sm text-neutral-600">{exp.location}</p>
          </div>
          <div>
            <h3 class="text-xl font-bold text-black">{exp.role}</h3>
            <p class="mt-0.5 text-base font-bold text-black">{exp.company}</p>
            <p class="mt-3 max-w-[62ch] text-base leading-relaxed text-neutral-800">{exp.description}</p>
            <ul class="mt-4 space-y-2">
              {exp.achievements.map((ach) => (
                <li class="flex gap-2.5 text-base leading-relaxed text-neutral-800">
                  <span aria-hidden="true" class="shrink-0 text-black">—</span>
                  <span>{ach}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
