---
import { experiences } from "../data/portfolio.ts";
---

<section id="experience" class="cv-lazy mx-auto max-w-6xl scroll-mt-28 px-4 pb-16 sm:px-6">
  <h2 class="text-3xl font-bold tracking-tight text-black sm:text-4xl">Experience</h2>
  <div class="mt-3 h-1.5 w-20 rounded-full bg-indigo-600" aria-hidden="true"></div>

  <ol class="mt-8 space-y-5">
    {
      experiences.map((exp) => (
        <li class="relative overflow-hidden rounded-3xl border border-neutral-200 bg-white p-6 shadow-sm sm:p-7">
          <span class="absolute inset-y-0 left-0 w-1.5" style={`background:${exp.accent}`} aria-hidden="true" />
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h3 class="text-xl font-bold text-black">{exp.role}</h3>
              <p class="mt-1 text-base font-bold text-indigo-700">
                {exp.company} <span class="font-medium text-neutral-600">· {exp.location}</span>
              </p>
            </div>
            <span class="w-fit shrink-0 rounded-lg bg-neutral-100 px-3 py-1.5 font-mono text-xs font-bold text-neutral-700">
              {exp.period}
            </span>
          </div>
          <p class="mt-4 text-base leading-relaxed text-neutral-700">{exp.description}</p>
          <ul class="mt-5 space-y-2.5">
            {exp.achievements.map((ach) => (
              <li class="flex items-start gap-2.5 rounded-xl bg-neutral-50 p-3.5 text-sm font-medium leading-relaxed text-neutral-800">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${exp.accent}`} aria-hidden="true" />
                <span>{ach}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
