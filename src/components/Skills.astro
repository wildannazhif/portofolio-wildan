---
import { skills } from "../data/portfolio.ts";
---

<!--
  Paper, not a dark panel: three ruled columns. Tools as a plain ruled list,
  not pills. No dark-mode-inverted block in the middle of a light document.
-->
<section id="skills" aria-labelledby="skills-heading" class="cv-lazy mx-auto max-w-6xl scroll-mt-8 px-4 pb-14 sm:px-6">
  <div class="border-t-2 border-black pt-4">
    <h2 id="skills-heading" class="text-3xl font-bold tracking-tight text-black sm:text-4xl">Skill Set &amp; Achievements</h2>
  </div>
  <div class="mt-2 grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-12">
    <div>
      <h3 class="border-b border-black pb-2 text-xs font-bold uppercase tracking-[0.18em] text-black">Technical</h3>
      <ul>
        {
          skills.hard.map((skill) => (
            <li class="border-b border-neutral-200 py-2.5 text-base font-medium text-black">{skill}</li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="border-b border-black pb-2 text-xs font-bold uppercase tracking-[0.18em] text-black">Soft Skills</h3>
      <ul>
        {
          skills.soft.map((skill) => (
            <li class="border-b border-neutral-200 py-2.5 text-base font-medium text-black">{skill}</li>
          ))
        }
      </ul>
      <h3 class="mt-10 border-b border-black pb-2 text-xs font-bold uppercase tracking-[0.18em] text-black">Interests</h3>
      <p class="mt-3 text-base leading-relaxed text-black">{skills.interests.join(" · ")}</p>
    </div>
    <div class="sm:col-span-2 lg:col-span-1">
      <h3 class="border-b border-black pb-2 text-xs font-bold uppercase tracking-[0.18em] text-black">Achievements</h3>
      {
        skills.achievements.map((ach) => (
          <p class="mt-3 text-base leading-relaxed text-neutral-800">{ach}</p>
        ))
      }
    </div>
  </div>
</section>
