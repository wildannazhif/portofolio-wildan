---
import { Picture } from "astro:assets";
import { profile } from "../data/portfolio.ts";

// Only surviving copy of the portrait (v1's committed jpg was byte-corrupted).
const portraitUrl = "https://i.ibb.co.com/LXtXkGmN/1766358560221.jpg";
---

<section class="mx-auto max-w-6xl px-4 pb-12 pt-8 sm:px-6 sm:pt-12 lg:pb-16">
  <div class="grid items-center gap-8 lg:grid-cols-[1fr_360px]">
    <div>
      <p class="inline-flex items-center rounded-full border border-indigo-100 bg-indigo-50 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-indigo-700">
        <span class="mr-2 inline-block h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
        Available for hire
      </p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.08] tracking-tight text-black sm:text-6xl">
        {profile.name}
      </h1>
      <p class="mt-3 max-w-xl text-lg font-medium text-neutral-700 sm:text-xl">{profile.title}</p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="flex min-h-12 items-center rounded-full bg-indigo-600 px-7 text-base font-bold text-white"
        >
          Get in Touch
        </a>
        <a
          href={profile.linkedin}
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn — Wildan Nazhif Irsyadi"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-neutral-200 text-black hover:border-indigo-200 hover:bg-indigo-50"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.31V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" /></svg>
        </a>
        <a
          href={profile.github}
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub — wildannazhif"
          class="flex h-12 w-12 items-center justify-center rounded-full border border-neutral-200 text-black hover:bg-neutral-100"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.23v3.3c0 .32.22.7.83.58A12 12 0 0 0 12 .3z" /></svg>
        </a>
      </div>

      <p class="mt-6 flex items-center gap-2 text-sm font-medium text-neutral-700">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0z" /><circle cx="12" cy="10" r="3" /></svg>
        {profile.location}
      </p>
    </div>

    <div class="mx-auto w-full max-w-[320px] lg:max-w-none">
      <Picture
        src={portraitUrl}
        widths={[288, 360, 480]}
        formats={["avif", "webp", "jpeg"]}
        sizes="(max-width: 1024px) 320px, 360px"
        width={360}
        height={360}
        alt={profile.name}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-square w-full rounded-3xl border-4 border-white object-cover shadow-lg"
      />
      <p class="mt-3 text-center text-xs font-medium text-neutral-500">
        Statistics · ITS Surabaya · Class of 2026
      </p>
    </div>
  </div>
</section>
