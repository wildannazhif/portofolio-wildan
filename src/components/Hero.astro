---
import { Picture } from "astro:assets";
import { profile } from "../data/portfolio.ts";

// Only surviving copy of the portrait (v1's committed jpg was byte-corrupted).
const portraitUrl = "https://i.ibb.co.com/LXtXkGmN/1766358560221.jpg";
---

<!--
  Opening of the document: display name, role, contact line, lede paragraph,
  and a tightly cropped portrait with a caption. No badge, no pill buttons,
  no banner. The summary is the lede — it opens the document, it is not a
  coloured box.
-->
<section class="mx-auto max-w-6xl px-4 pb-10 pt-8 sm:px-6 sm:pt-10">
  <div class="grid gap-8 lg:grid-cols-[1fr_220px] lg:gap-12">
    <div>
      <h1 class="text-5xl font-bold leading-[0.98] tracking-tight text-black sm:text-7xl">
        Wildan Nazhif<br />Irsyadi
      </h1>
      <p class="mt-4 text-xl font-bold text-black sm:text-2xl">{profile.title}</p>
      <p class="mt-4 text-sm leading-relaxed text-black">
        {profile.location}
        <span aria-hidden="true" class="px-1.5 text-neutral-400">·</span>
        <a href={`mailto:${profile.email}`} class="underline decoration-neutral-300 underline-offset-4 hover:decoration-black">
          {profile.email}
        </a>
        <span aria-hidden="true" class="px-1.5 text-neutral-400">·</span>
        <a href={profile.linkedin} target="_blank" rel="noreferrer" class="underline decoration-neutral-300 underline-offset-4 hover:decoration-black">
          LinkedIn&nbsp;↗
        </a>
        <span aria-hidden="true" class="px-1.5 text-neutral-400">·</span>
        <a href={profile.github} target="_blank" rel="noreferrer" class="underline decoration-neutral-300 underline-offset-4 hover:decoration-black">
          GitHub&nbsp;↗
        </a>
      </p>
      <p class="mt-8 max-w-[62ch] text-base leading-relaxed text-neutral-800 sm:text-lg">
        {profile.summary}
      </p>
    </div>

    <figure class="m-0 max-w-[240px]">
      <Picture
        src={portraitUrl}
        widths={[220, 320, 440]}
        formats={["avif", "webp", "jpeg"]}
        sizes="(max-width: 1024px) 240px, 220px"
        width={220}
        height={260}
        alt={profile.name}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="aspect-[220/260] w-full border border-neutral-300 object-cover"
      />
      <figcaption class="mt-2 text-xs leading-relaxed text-neutral-600">
        {profile.name} — Statistics, ITS Surabaya, class of 2026.
      </figcaption>
    </figure>
  </div>
</section>
