---
import { profile } from "../data/portfolio.ts";
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 bg-white py-10">
  <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
    <div class="mb-6 flex justify-center gap-2">
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn — Wildan Nazhif Irsyadi"
        class="flex h-11 w-11 items-center justify-center rounded-full text-black hover:bg-indigo-50 hover:text-indigo-700"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.31V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z" /></svg>
      </a>
      <a
        href={profile.github}
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub — wildannazhif"
        class="flex h-11 w-11 items-center justify-center rounded-full text-black hover:bg-neutral-100"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.23v3.3c0 .32.22.7.83.58A12 12 0 0 0 12 .3z" /></svg>
      </a>
      <a
        href={`mailto:${profile.email}`}
        aria-label={`Email ${profile.email}`}
        class="flex h-11 w-11 items-center justify-center rounded-full text-black hover:bg-rose-50 hover:text-rose-600"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
      </a>
    </div>
    <p class="text-sm font-bold text-neutral-700">Designed &amp; Built by {profile.name}</p>
    <p class="mt-1 text-xs font-medium uppercase tracking-widest text-neutral-500">
      © {year} · Statistics &amp; Data Science
    </p>
  </div>
</footer>
