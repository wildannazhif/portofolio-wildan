---
import { profile } from "../data/portfolio.ts";
const year = new Date().getFullYear();
---

<!--
  Colophon, not a carbon-copy footer: left-aligned, hairline rule, inline
  text links, honest production notes. No centred icon row, no logo.
-->
<footer class="mx-auto max-w-6xl px-4 pb-10 sm:px-6">
  <div class="border-t-2 border-black pt-4">
    <p class="text-base font-bold text-black">{profile.name}</p>
    <p class="mt-2 text-sm leading-relaxed text-black">
      <a href={`mailto:${profile.email}`} class="underline decoration-neutral-300 underline-offset-4 hover:decoration-black">
        {profile.email}
      </a>
      <span aria-hidden="true" class="px-1.5 text-neutral-400">·</span>
      <a href={profile.linkedin} target="_blank" rel="noreferrer" class="underline decoration-neutral-300 underline-offset-4 hover:decoration-black">
        LinkedIn&nbsp;↗
      </a>
      <span aria-hidden="true" class="px-1.5 text-neutral-400">·</span>
      <a href={profile.github} target="_blank" rel="noreferrer" class="underline decoration-neutral-300 underline-offset-4 hover:decoration-black">
        GitHub&nbsp;↗
      </a>
      <span aria-hidden="true" class="px-1.5 text-neutral-400">·</span>
      <a href={profile.resume} target="_blank" rel="noreferrer" class="underline decoration-neutral-300 underline-offset-4 hover:decoration-black">
        Résumé&nbsp;↗
      </a>
    </p>
    <p class="tnum mt-4 text-xs leading-relaxed text-neutral-600">
      Set in Arial · Built with Astro · Zero JavaScript shipped · © {year} {profile.name}
    </p>
  </div>
</footer>
